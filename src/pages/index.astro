---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import Hero from '@/components/sections/Hero.astro';
import StatsBand from '@/components/sections/StatsBand.astro';
import LogoMarquee from '@/components/sections/LogoMarquee.astro';
import Portals from '@/components/sections/Portals.astro';
import Modules from '@/components/sections/Modules.astro';
import Features from '@/components/sections/Features.astro';
import Setup from '@/components/sections/Setup.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import Faq from '@/components/sections/Faq.astro';
import Cta from '@/components/sections/Cta.astro';
---

<BaseLayout>
  <Header />

  <main id="top">
    <Hero />
    <StatsBand />
    <LogoMarquee />
    <Portals />
    <Modules />
    <Features />
    <Setup />
    <Testimonials />
    <Faq />
    <Cta />
  </main>

  <Footer />
  <WhatsAppButton />
</BaseLayout>
