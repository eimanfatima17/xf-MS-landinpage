---
import { whatsappDemoUrl } from '@/data/site';
---

<section class="hero">
  <div class="shell hero-stack">
    <div class="hero-top reveal">
      <p class="hero-eyebrow">Admissions, fees, attendance, payroll and lecture content in a single branded platform — with separate portals for admins, managers, instructors and students.</p>
      <h1 id="heroHeadline">One login runs the <span class="accent">whole</span> institute.</h1>
    </div>

    <div class="frame hero-frame reveal" id="heroFrame">
      <div class="frame-bar">
        <i></i><i></i><i></i>
        <span class="frame-url">portal.yourinstitute.com/admin</span>
      </div>
      <div class="portal">
        <aside class="rail">
          <div class="rail-brand"><span class="brand-mark"><img src="/assets/logo-mark.png" alt="Extreme IMS logo"></span>Extreme IMS</div>
          <div class="rail-group">Main</div>
          <div class="rail-item on"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>Dashboard</div>
          <div class="rail-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/></svg>Branches</div>
          <div class="rail-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/></svg>Staff Users</div>
          <div class="rail-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>Alerts</div>
          <div class="rail-group">Academics</div>
          <div class="rail-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>Courses</div>
          <div class="rail-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>Batches</div>
          <div class="rail-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>Instructors</div>
          <div class="rail-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m22 8-6 4 6 4V8Z"/><rect x="2" y="6" width="14" height="12" rx="2"/></svg>LMS</div>
          <div class="rail-group">Students</div>
          <div class="rail-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg>Students</div>
          <div class="rail-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M4 21h16"/></svg>Import Students</div>
          <div class="rail-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="8" r="6"/><path d="M9 14.5 7 21l5-3 5 3-2-6.5"/></svg>Certificates</div>
          <div class="rail-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M19 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0 0 4h15a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5"/><path d="M18 12h.01"/></svg>Fees</div>
        </aside>

        <div class="pane">
          <div class="pane-head">
            <div>
              <h4>Overview</h4>
              <p class="micro">1 Sep – 16 Sep 2026 · All branches</p>
            </div>
            <span class="chip">This month</span>
          </div>

          <div class="stat-row">
            <div class="statcard">
              <div class="top">
                <div>
                  <div class="label">Total Students</div>
                  <div class="value" data-count="1284">0</div>
                  <span class="badge">+38 this month</span>
                </div>
                <div class="tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg></div>
              </div>
            </div>
            <div class="statcard">
              <div class="top">
                <div>
                  <div class="label">Active Enrollments</div>
                  <div class="value" data-count="946">0</div>
                  <span class="badge">31 batches</span>
                </div>
                <div class="tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg></div>
              </div>
            </div>
            <div class="statcard">
              <div class="top">
                <div>
                  <div class="label">Fee Collection</div>
                  <div class="value" data-count="4.82" data-prefix="Rs " data-suffix="M" data-decimals="2">0</div>
                  <span class="badge">91% on time</span>
                </div>
                <div class="tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M19 7V5a2 2 0 0 0-2-2H5a2 2 0 0 0 0 4h15a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5"/><path d="M18 12h.01"/></svg></div>
              </div>
            </div>
            <div class="statcard">
              <div class="top">
                <div>
                  <div class="label">Net Position</div>
                  <div class="value" data-count="1.37" data-prefix="Rs " data-suffix="M" data-decimals="2">0</div>
                  <span class="badge">after payroll</span>
                </div>
                <div class="tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-4 4"/></svg></div>
              </div>
            </div>
          </div>

          <div class="chartcard">
            <div class="chart-top">
              <h5>Revenue vs expense</h5>
              <span class="chip">Last 8 weeks</span>
            </div>
            <div class="bars" id="bars">
              <div class="bar"><span data-h="42"></span></div>
              <div class="bar"><span data-h="55"></span></div>
              <div class="bar"><span data-h="48"></span></div>
              <div class="bar"><span data-h="67"></span></div>
              <div class="bar"><span data-h="61"></span></div>
              <div class="bar"><span data-h="78"></span></div>
              <div class="bar"><span data-h="72"></span></div>
              <div class="bar"><span data-h="94"></span></div>
            </div>
            <div class="bar-x"><i>W1</i><i>W2</i><i>W3</i><i>W4</i><i>W5</i><i>W6</i><i>W7</i><i>W8</i></div>
          </div>
        </div>
      </div>
      <div class="frame-ai" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg></div>
    </div>

    <div class="hero-ctas">
      <a class="btn btn-primary" target="_blank" rel="noopener" href={whatsappDemoUrl}>
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.87.5 3.62 1.44 5.14L2 22l5.13-1.55a9.87 9.87 0 0 0 4.9 1.28h.01c5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2zm0 17.85h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.94.94-3.04-.2-.31a8.18 8.18 0 0 1-1.26-4.2c0-4.52 3.68-8.19 8.2-8.19 2.19 0 4.25.85 5.8 2.4a8.14 8.14 0 0 1 2.4 5.8c0 4.52-3.68 8.19-8.2 8.19zm4.48-6.12c-.24-.12-1.44-.71-1.66-.79-.22-.08-.38-.12-.55.12-.16.24-.63.79-.77.95-.14.16-.28.18-.52.06-.24-.12-1.01-.37-1.92-1.18-.71-.63-1.19-1.41-1.33-1.65-.14-.24-.01-.37.11-.49.12-.12.28-.31.42-.47.14-.16.19-.28.28-.46.1-.19.05-.35-.03-.47-.08-.12-.5-1.2-.68-1.65-.18-.44-.36-.38-.5-.39h-.42c-.14 0-.37.05-.56.28-.19.24-.75.73-.75 1.77s.77 2.05.88 2.19c.11.14 1.48 2.26 3.6 3.08 1.79.69 2.17.58 2.55.53.38-.05 1.22-.5 1.4-.98.17-.48.17-.9.12-.98-.05-.08-.19-.13-.43-.24z"/></svg>
        Book a demo on WhatsApp
      </a>
      <a class="btn btn-outline" href="#portals">See the portals</a>
    </div>
    <div class="hero-trust">
      <span>Runs on your domain</span>
      <span>Your logo and colours</span>
      <span>Nothing to install</span>
    </div>
  </div>
</section>
